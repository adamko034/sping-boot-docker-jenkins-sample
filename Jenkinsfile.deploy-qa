pipeline {
    agent any

    parameters {
        string(
            name: 'VERSION',
            defaultValue: '',
            description: 'Released version to deploy to QA (e.g. 0.0.4). No SNAPSHOT.'
        )
    }

    environment {
        DOCKER_IMAGE = 'adamko034/hello-world'
    }

    stages {
        stage('Resolve version') {
            environment {
                KUBECONFIG = credentials('minikube-kubeconfig')
            }
            steps {
                checkout scm
                script {
                    def version = params.VERSION?.trim()
                    if (!version) {
                        error 'VERSION is required. Use Build with Parameters and enter a release version (e.g. 0.0.4).'
                    }
                    if (version.endsWith('-SNAPSHOT')) {
                        error "SNAPSHOT versions are not allowed for QA promote: ${version}"
                    }

                    def currentQa = sh(
                        script: '''
                            helm get values hello-world -n hello-world-qa -o json 2>/dev/null \
                              | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('image',{}).get('tag',''))" \
                              2>/dev/null || true
                        ''',
                        returnStdout: true
                    ).trim()
                    env.CURRENT_QA_VERSION = currentQa ?: 'none'
                    env.VERSION = version

                    echo "Current QA version: ${env.CURRENT_QA_VERSION}"
                    echo "Will deploy version: ${env.VERSION}"
                }
            }
        }

        stage('Confirm QA deploy') {
            options {
                timeout(time: 1, unit: 'HOURS')
            }
            steps {
                input message: "Deploy version ${env.VERSION} to QA? (current QA: ${env.CURRENT_QA_VERSION})"
            }
        }

        stage('Deploy QA') {
            environment {
                KUBECONFIG = credentials('minikube-kubeconfig')
            }
            steps {
                sh '''
                    helm upgrade --install hello-world ./helm/hello-world \
                      -n hello-world-qa \
                      -f ./helm/hello-world/values-qa.yaml \
                      --set image.repository=${DOCKER_IMAGE} \
                      --set image.tag=${VERSION} \
                      --create-namespace
                '''
            }
        }
    }
}

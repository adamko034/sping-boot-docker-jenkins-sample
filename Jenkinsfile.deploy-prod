pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'adamko034/hello-world'
    }

    stages {
        stage('Fetch versions') {
            environment {
                KUBECONFIG = credentials('minikube-kubeconfig')
            }
            steps {
                checkout scm
                script {
                    sh 'git fetch --tags --force'

                    def tags = sh(
                        script: "git tag -l '[0-9]*' --sort=-v:refname | head -20",
                        returnStdout: true
                    ).trim()

                    if (!tags) {
                        tags = sh(
                            script: "git tag -l 'v[0-9]*' --sort=-v:refname | head -20 | sed 's/^v//'",
                            returnStdout: true
                        ).trim()
                    }

                    if (!tags) {
                        error 'No release tags found. Run a release job first.'
                    }

                    def currentProd = sh(
                        script: '''
                            helm get values hello-world -n hello-world-prod -o json 2>/dev/null \
                              | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('image',{}).get('tag',''))" \
                              2>/dev/null || true
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!currentProd) {
                        currentProd = 'none'
                    }
                    env.CURRENT_PROD_VERSION = currentProd
                    echo "Current PROD version: ${currentProd}"

                    def choices = tags.split('\n').toList().findAll { it && it != currentProd }

                    if (choices.isEmpty()) {
                        error "No other versions available to deploy (current PROD is ${currentProd})."
                    }

                    env.RELEASE_TAGS = choices.join('\n')
                    echo "Selectable versions (newest first):\n${env.RELEASE_TAGS}"
                }
            }
        }

        stage('Select version') {
            steps {
                script {
                    def choices = env.RELEASE_TAGS.split('\n').toList()
                    def selected = input(
                        message: "Current prod version is ${env.CURRENT_PROD_VERSION}. Select version to deploy:",
                        parameters: [
                            choice(name: 'VERSION', choices: choices)
                        ]
                    )
                    env.VERSION = selected instanceof Map ? selected.VERSION : selected
                }
            }
        }

        stage('Confirm PROD deploy') {
            options {
                timeout(time: 1, unit: 'HOURS')
            }
            steps {
                input message: "Current prod version is ${env.CURRENT_PROD_VERSION}. You are about to deploy ${env.VERSION}. Proceed?"
            }
        }

        stage('Deploy PROD') {
            environment {
                KUBECONFIG = credentials('minikube-kubeconfig')
            }
            steps {
                sh '''
                    helm upgrade --install hello-world ./helm/hello-world \
                      -n hello-world-prod \
                      -f ./helm/hello-world/values-prod.yaml \
                      --set image.repository=${DOCKER_IMAGE} \
                      --set image.tag=${VERSION} \
                      --create-namespace
                '''
            }
        }
    }
}

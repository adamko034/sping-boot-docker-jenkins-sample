pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'adamko034/hello-world'
    }

    stages {
        stage('Resolve version') {
            environment {
                KUBECONFIG = credentials('minikube-kubeconfig')
            }
            steps {
                checkout scm
                script {
                    sh 'git fetch --tags --force'

                    def tags = sh(
                        script: "git tag -l '[0-9]*' --sort=-v:refname | head -10",
                        returnStdout: true
                    ).trim()

                    if (!tags) {
                        tags = sh(
                            script: "git tag -l 'v[0-9]*' --sort=-v:refname | head -10 | sed 's/^v//'",
                            returnStdout: true
                        ).trim()
                    }

                    def tagList = tags ? tags.split('\n').toList().findAll { it } : []
                    def choices = (['select'] + tagList)

                    // Refresh Build with Parameters for the next run
                    properties([
                        parameters([
                            choice(
                                name: 'VERSION',
                                choices: choices,
                                description: 'Last 10 release tags. Leave as "select" if you enter a custom version below.'
                            ),
                            string(
                                name: 'CUSTOM_VERSION',
                                defaultValue: '',
                                description: 'Optional custom version. Required when VERSION is "select".'
                            )
                        ])
                    ])

                    if (!tagList && !(params.CUSTOM_VERSION?.trim())) {
                        error 'No release tags found and no CUSTOM_VERSION provided. Run a release job first.'
                    }

                    def currentProd = sh(
                        script: '''
                            helm get values hello-world -n hello-world-prod -o json 2>/dev/null \
                              | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('image',{}).get('tag',''))" \
                              2>/dev/null || true
                        ''',
                        returnStdout: true
                    ).trim()
                    env.CURRENT_PROD_VERSION = currentProd ?: 'none'

                    def custom = params.CUSTOM_VERSION?.trim()
                    def selected = params.VERSION?.trim()
                    def version

                    if (custom) {
                        version = custom
                    } else if (selected && selected != 'select') {
                        version = selected
                    } else {
                        error 'Version required: choose a tag from VERSION, or enter CUSTOM_VERSION. "select" is not a valid version.'
                    }

                    env.VERSION = version
                    echo "Current PROD version: ${env.CURRENT_PROD_VERSION}"
                    echo "Will deploy version: ${env.VERSION}"
                }
            }
        }

        stage('Confirm PROD deploy') {
            options {
                timeout(time: 1, unit: 'HOURS')
            }
            steps {
                input message: "Deploy version ${env.VERSION} to PROD? (current PROD: ${env.CURRENT_PROD_VERSION})"
            }
        }

        stage('Deploy PROD') {
            environment {
                KUBECONFIG = credentials('minikube-kubeconfig')
            }
            steps {
                sh '''
                    helm upgrade --install hello-world ./helm/hello-world \
                      -n hello-world-prod \
                      -f ./helm/hello-world/values-prod.yaml \
                      --set image.repository=${DOCKER_IMAGE} \
                      --set image.tag=${VERSION} \
                      --create-namespace
                '''
            }
        }
    }
}
